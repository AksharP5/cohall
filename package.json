{
  "name": "@akshar5/cohall",
  "version": "0.5.5",
  "description": "Let coding agents delegate work across your own devices.",
  "keywords": [
    "agents",
    "cli",
    "codex",
    "mcp",
    "remote"
  ],
  "homepage": "https://github.com/AksharP5/cohall#readme",
  "bugs": {
    "url": "https://github.com/AksharP5/cohall/issues"
  },
  "license": "MIT",
  "author": "Akshar Patel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AksharP5/cohall.git"
  },
  "bin": {
    "cohall": "bin/cohall.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "bin",
    "deploy",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start:relay": "bun run build:package && node bin/cohall.js relay",
    "start:device": "bun run build:package && node bin/cohall.js device",
    "mcp": "bun run build:package && node bin/cohall.js mcp",
    "cli": "bun run build:package && node bin/cohall.js",
    "doctor": "bun run build:package && node bin/cohall.js doctor",
    "build": "bun run build:packages && bun run build:package",
    "build:package": "bun scripts/build-package.ts",
    "build:packages": "bunx tsc -b packages/protocol packages/client packages/providers apps/relay apps/device",
    "typecheck": "bunx tsc -b",
    "test": "bun run build:package && vitest run",
    "lint": "bunx oxlint . --deny-warnings",
    "format": "bunx oxfmt . '!CHANGELOG.md'",
    "format:check": "bunx oxfmt --check . '!CHANGELOG.md'",
    "package:check": "npm pack --dry-run --ignore-scripts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run package:check",
    "prepack": "bun run build:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "effect": "4.0.0-beta.102",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.77.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^3.1.5",
    "hono": "^4.12.34"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.13"
}
