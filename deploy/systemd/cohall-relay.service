[Unit]
Description=Cohall relay
After=network-online.target cohall-relay.socket
Wants=network-online.target
Requires=cohall-relay.socket

[Service]
Type=simple
User=cohall
Group=cohall
EnvironmentFile=/etc/cohall/relay.env
ExecStart=/usr/local/bin/cohall relay
Sockets=cohall-relay.socket
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=cohall
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cohall
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
